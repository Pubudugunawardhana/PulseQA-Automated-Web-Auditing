{
  "name": "@pulseqa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/tsx/dist/cli.mjs watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node ../../node_modules/tsx/dist/cli.mjs --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "db:generate": "node ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node ../../node_modules/drizzle-kit/bin.cjs migrate",
    "playwright:install": "node ../../node_modules/playwright/cli.js install chromium firefox webkit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@pulseqa/shared": "*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
