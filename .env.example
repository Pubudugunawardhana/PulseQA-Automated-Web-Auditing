# Neon pooled connection string (Neon console -> Connect -> Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/pulseqa?sslmode=require
PORT=4000
MAX_CONCURRENT_AUDITS=2
# Audits kept per browser (older ones + screenshots are removed automatically)
HISTORY_LIMIT=10
# Audits older than this many days are deleted automatically
HISTORY_MAX_AGE_DAYS=10
# Pages the Site Crawl check visits per audit (1-200)
CRAWL_MAX_PAGES=20
# true = allow auditing localhost / private network apps (dev). Set false on a public deployment.
ALLOW_PRIVATE_HOSTS=true
ARTIFACTS_DIR=./artifacts
CORS_ORIGIN=http://localhost:5173
# Only if the web app and API are deployed on DIFFERENT sites (e.g. Vercel + Render):
# owner cookie becomes SameSite=None; Secure. Leave false when the API also serves the web app.
CROSS_SITE_COOKIES=false
# Built React app served by the API for a single-service deploy (npm run build first)
WEB_DIST_DIR=../web/dist
